# Go
/bin/
/dist/
*.test
coverage.out
# `make build` writes the binaries to the repo root. They were tracked for
# several releases (T-2411): 51 MB of build output, re-added to every commit
# that rebuilt them, and a merge conflict nobody can resolve by reading it.
/vnproxd
/vnproxctl

# Packaging (make deb scratch space; see packaging/Makefile)
/packaging/build/

# Frontend
node_modules/
# web/dist is otherwise a build artifact (populated by `npm run build`), but
# a placeholder index.html is checked in (T-002) so `//go:embed all:dist` in
# web/assets.go has something to embed before T-005's frontend exists. Real
# builds overwrite it in place; T-005 may want to revisit this exception
# once that's the steady state.
web/dist/*
!web/dist/index.html
*.tsbuildinfo
# Playwright (opt-in e2e — `npm run e2e`; baselines in *-snapshots/ ARE committed)
web/test-results/
web/playwright-report/
# T-3809's OpenAPI generated-client drift check (web/tools/openapi-drift):
# regenerated from docs/openapi.json on every run, never committed.
web/.openapi-drift/

# Local dev
/.env
/.env.local
*.db
*.sqlite
/var/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Agent tooling (isolated worktrees for parallel sub-agent tasks)
/.claude/worktrees/

# scripts/ci-local.sh per-job logs. GitHub Actions is unfunded for this
# repository, so that script is the gate; its output is a local artifact and
# is never committed.
/.ci-local/
