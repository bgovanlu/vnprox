auto lo
iface lo inet loopback

allow-ovs vmbr0
iface vmbr0 inet static
	address 10.10.0.5/24
	ovs_type OVSBridge
	ovs_ports bond0

allow-vmbr0 bond0
iface bond0 inet manual
	ovs_bonds eno1 eno2
	ovs_type OVSBond
	ovs_bridge vmbr0
	ovs_options bond_mode=balance-slb lacp=active other_config:lacp-time=fast
