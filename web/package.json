    "@tanstack/react-query": "^5.101.2",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "elkjs": "^0.11.1",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
