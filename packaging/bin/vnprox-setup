#!/usr/bin/env bash
# vnprox-setup — per-node interactive setup, run after `apt install
# ./vnprox_<version>_<arch>.deb`. Implements steps 2 and 5-7 of
# docs/deployment.md's documented install flow:
#
#   2. Check port 8007 (PBS conflict); ask for the listen port if needed.
#   5. Create the read-only PVE API token vnprox@pve!daemon.
#   6. Generate the cluster secret in /etc/pve/priv/vnprox/ (first node
#      only; pmxcfs replicates it). Deliberately under priv/, not just
#      /etc/pve/vnprox/: pmxcfs only auto-restricts files under priv/ to
#      0600 root-only (it silently coerces everything else to 0640
#      root:www-data and rejects chmod() outright — confirmed against a
#      real PVE 9.2.4 node), so this is the one location that actually
#      delivers the root-only guarantee docs/security.md documents.
#   7. Write /etc/vnprox/vnprox.toml, generate the session key, enable +
#      start vnprox.service.
#
# install.sh drives this same script per node (locally, or — once T-606
# lands — over SSH) rather than re-implementing this logic; this is also
# exactly what docs/deployment.md's "Manual install (per node)" section
# tells an operator to run by hand.
#
# Parts genuinely requiring a live Proxmox VE cluster are marked
# TODO(T-606) and do not pretend to work here — see planning/tasks/
# phase-6.md#T-606 ("cluster rollout and PVE token creation are completed
# in T-606").

set -euo pipefail

PROG=$(basename "$0")
CONFIG_PATH="/etc/vnprox/vnprox.toml"
KEYS_DIR="/etc/vnprox/keys"
SESSION_KEY_FILE="$KEYS_DIR/session.key"
PVE_CLUSTER_DIR="/etc/pve/priv/vnprox"
CLUSTER_SECRET_FILE="$PVE_CLUSTER_DIR/cluster.secret"
DEFAULT_PORT=8007
FALLBACK_PORT=8008

PORT=""
WITH_LLDP=""
ASSUME_YES=0
ANSWERS_FILE=""

usage() {
	cat <<EOF
Usage: $PROG [options]

Options:
  --port <n>          Use this listen port without probing for a conflict.
  --with-lldp         Install and enable lldpd (default: prompt, yes).
  --no-lldp           Skip lldpd install.
  --answers <file>    Non-interactive: read PORT= and WITH_LLDP=yes|no from
                       this file instead of prompting (shell-sourceable).
  -y, --yes           Non-interactive: accept documented defaults.
  -h, --help          Show this help.
EOF
}

log() { printf '>> %s\n' "$*" >&2; } # stderr: keeps stdout clean for callers that capture a function's result via $(...) (see resolve_port)
warn() { printf 'vnprox-setup: warning: %s\n' "$*" >&2; }
die() {
	printf 'vnprox-setup: error: %s\n' "$*" >&2
	exit 1
}

while [ $# -gt 0 ]; do
	case "$1" in
	--port)
		PORT="$2"
		shift 2
		;;
	--with-lldp)
		WITH_LLDP=yes
		shift
		;;
	--no-lldp)
		WITH_LLDP=no
		shift
		;;
	--answers)
		ANSWERS_FILE="$2"
		shift 2
		;;
	-y | --yes)
		ASSUME_YES=1
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		die "unknown option: $1 (see --help)"
		;;
	esac
done

if [ -n "$ANSWERS_FILE" ]; then
	[ -r "$ANSWERS_FILE" ] || die "--answers file not readable: $ANSWERS_FILE"
	# shellcheck disable=SC1090
	. "$ANSWERS_FILE"
	PORT="${PORT:-${ANSWER_PORT:-}}"
	WITH_LLDP="${WITH_LLDP:-${ANSWER_WITH_LLDP:-}}"
	ASSUME_YES=1
fi

if [ "$(id -u)" -ne 0 ]; then
	die "must run as root (vnprox needs to write /etc/vnprox, /etc/pve/priv/vnprox, and manage vnprox.service)"
fi

# --- step 2: port conflict detection --------------------------------------
#
# docs/deployment.md: "PBS's web UI also uses 8007. The installer checks
# for a listener on 8007 and an installed proxmox-backup-server package; if
# found it prompts for an alternative (suggested 8008) and writes it to
# config."

port_listening() {
	port="$1"
	if command -v ss >/dev/null 2>&1; then
		if ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[.:]${port}\$"; then
			return 0
		fi
	fi
	if command -v netstat >/dev/null 2>&1; then
		if netstat -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[.:]${port}\$"; then
			return 0
		fi
	fi
	# Portable fallback usable in minimal containers without ss/netstat:
	# bash's /dev/tcp pseudo-device attempts a real TCP connect. A
	# successful connect means *something* is accepting on that port.
	if (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null; then
		exec 3<&- 2>/dev/null || true
		exec 3>&- 2>/dev/null || true
		return 0
	fi
	return 1
}

pbs_installed() {
	if command -v dpkg-query >/dev/null 2>&1; then
		dpkg-query -W -f='${Status}' proxmox-backup-server 2>/dev/null | grep -q "install ok installed"
		return $?
	fi
	return 1
}

resolve_port() {
	if [ -n "$PORT" ]; then
		log "using explicitly requested port $PORT"
		echo "$PORT"
		return
	fi

	conflict=0
	if port_listening "$DEFAULT_PORT"; then
		warn "something is already listening on port $DEFAULT_PORT"
		conflict=1
	fi
	if pbs_installed; then
		warn "proxmox-backup-server is installed (its web UI also uses port $DEFAULT_PORT)"
		conflict=1
	fi

	if [ "$conflict" -eq 0 ]; then
		echo "$DEFAULT_PORT"
		return
	fi

	if [ "$ASSUME_YES" -eq 1 ]; then
		log "port $DEFAULT_PORT is in use; using fallback port $FALLBACK_PORT (non-interactive)"
		echo "$FALLBACK_PORT"
		return
	fi

	read -r -p "Port $DEFAULT_PORT looks unavailable. Use alternative port [$FALLBACK_PORT]: " chosen || true
	echo "${chosen:-$FALLBACK_PORT}"
}

RESOLVED_PORT="$(resolve_port)"
log "vnprox will listen on port $RESOLVED_PORT"

# --- lldpd (docs/deployment.md step 4, --with-lldp default yes) ----------

if [ -z "$WITH_LLDP" ]; then
	if [ "$ASSUME_YES" -eq 1 ]; then
		WITH_LLDP=yes
	else
		read -r -p "Install and enable lldpd for physical topology discovery? [Y/n] " ans || true
		case "$ans" in
		[nN]*) WITH_LLDP=no ;;
		*) WITH_LLDP=yes ;;
		esac
	fi
fi

if [ "$WITH_LLDP" = yes ]; then
	if command -v lldpd >/dev/null 2>&1; then
		log "lldpd already installed"
	elif command -v apt-get >/dev/null 2>&1; then
		log "installing lldpd"
		if apt-get install -y lldpd; then
			if [ -d /run/systemd/system ]; then
				systemctl enable --now lldpd >/dev/null 2>&1 || warn "installed lldpd but could not enable/start it"
			fi
		else
			warn "lldpd install failed; continuing without it (docs/features/lldp-discovery.md §1 covers the guided in-app install path once T-302 lands)"
		fi
	else
		warn "apt-get not available; skipping lldpd install"
	fi
else
	log "skipping lldpd (per --no-lldp / answer)"
fi

# --- step 5: PVE API token -------------------------------------------------
#
# Creates the read-only PVE identity docs/security.md documents: "one
# privileged internal identity: a PVE API token vnprox@pve!daemon ... used
# exclusively for read polling by collectors — never for writes." Every
# sub-step here is idempotent (re-running this script must not error or
# create duplicates — T-606 acceptance criterion 5):
#   - the VnproxAuditor role is created only if pveum doesn't already list it
#     (a stock PVE always ships PVEAuditor too, but vnprox uses its own
#     named role rather than depending on a stock role's exact privilege
#     set never changing underneath it);
#   - the vnprox@pve user and its "/"-scoped VnproxAuditor ACL grant are
#     created/re-applied unconditionally — pveum's own add/modify commands
#     are themselves idempotent (user add on an existing user, acl modify
#     re-granting the same role) so there is nothing to guard here;
#   - the token itself is created only if pveum doesn't already list a
#     "daemon" token for vnprox@pve — a token's secret is returned by pveum
#     exactly once at creation time and cannot be re-read later, so a
#     second `pveum user token add` on an existing token either errors or
#     (with pveum's own idempotency: it does not) silently invalidates the
#     first secret; either way this script must not attempt it on a token
#     that already exists. When skipped, the existing on-disk
#     PVE_TOKEN_FILE is left exactly as it was.
#
# `pveum` only exists on a real Proxmox VE node (it drives PVE's own
# pmxcfs-backed user.cfg); on any other host (dev machine, CI/container
# matrix) this step is a documented no-op — see the T-606 report's
# "needs hardware validation" list.

PVE_TOKEN_FILE="$KEYS_DIR/pve-token"
VNPROX_PVE_ROLE="VnproxAuditor"
# Sys.Audit: node status/interfaces (GET /nodes/{node}/*), cluster status.
# VM.Audit: qemu/lxc config reads (guest NIC inventory).
# SDN.Audit: SDN zone/vnet/subnet reads.
# Mapping.Audit: GET /cluster/notifications/targets (T-602's findings
# notification hook) — hardware validation (T-608) found real PVE gates
# this specific route on Mapping.Audit at /mapping/notifications, not
# Sys.Audit at / like every other route this token calls; every
# notification attempt failed with "Permission check failed" until this
# was added. No *.Modify privilege anywhere — the collectors' token is
# read-only by design (docs/security.md, D3).
VNPROX_PVE_PRIVS="Sys.Audit,VM.Audit,SDN.Audit,Mapping.Audit"

# pve_try_create runs a pveum create-style subcommand and treats "the thing
# it would create already exists" as success rather than failure: pveum's
# own error text for this case is "... already exists" (role/user/token
# add all phrase it this way), so this is more robust than pre-parsing
# `pveum <resource> list`'s human-oriented table output (whose exact column
# layout/separators aren't a stable contract this script should depend on,
# and vary across pveum versions). Logs $2 on success/already-exists, warns
# with pveum's own stderr on any other failure. Prints the command's stdout
# on success (needed by the token-add caller below to recover the secret).
pve_try_create() {
	local label out rc
	label="$1"
	shift
	out="$("$@" 2>&1)"
	rc=$?
	if [ $rc -eq 0 ]; then
		log "  $label"
		printf '%s\n' "$out"
		return 0
	fi
	if printf '%s' "$out" | grep -qi "already exists"; then
		log "  $label (already existed)"
		return 0
	fi
	warn "  $label failed: $out"
	return 1
}

if ! command -v pveum >/dev/null 2>&1; then
	log "step 5: pveum not found (not a Proxmox VE node) — skipping PVE API token provisioning"
	log "  -> on a real PVE node this creates role $VNPROX_PVE_ROLE, user vnprox@pve, and the vnprox@pve!daemon token; see docs/security.md"
else
	pve_try_create "role $VNPROX_PVE_ROLE ($VNPROX_PVE_PRIVS)" \
		pveum role add "$VNPROX_PVE_ROLE" -privs "$VNPROX_PVE_PRIVS" >/dev/null || true

	# Always reassert the role's privilege set too, even on an idempotent
	# re-run that skips user/token creation below: `pveum role add` on an
	# already-existing role is a no-op (the "already existed" branch just
	# above), so an upgrade that changes VNPROX_PVE_PRIVS (like T-608 adding
	# Mapping.Audit) would otherwise never actually reach an existing
	# install. `role modify` is safe to run unconditionally, every time,
	# whether the role was just created or already existed.
	if pveum role modify "$VNPROX_PVE_ROLE" -privs "$VNPROX_PVE_PRIVS" >/dev/null 2>&1; then
		log "  role $VNPROX_PVE_ROLE privileges up to date ($VNPROX_PVE_PRIVS)"
	else
		warn "  could not update role $VNPROX_PVE_ROLE to privs $VNPROX_PVE_PRIVS"
	fi
fi

if ! command -v pveum >/dev/null 2>&1; then
	: # already logged above
elif [ -s "$PVE_TOKEN_FILE" ]; then
	log "step 5: PVE API token file already present at $PVE_TOKEN_FILE, leaving it untouched (idempotent re-run)"
else
	log "step 5: provisioning the PVE API token vnprox@pve!daemon"

	pve_try_create "user vnprox@pve" \
		pveum user add vnprox@pve --comment "vnprox daemon read-only identity (docs/security.md)" >/dev/null || true

	if pveum acl modify / --users vnprox@pve --roles "$VNPROX_PVE_ROLE" 2>&1; then
		log "  granted $VNPROX_PVE_ROLE on / to vnprox@pve"
	else
		warn "  could not grant $VNPROX_PVE_ROLE on / to vnprox@pve; PVE API token setup incomplete"
	fi

	# set +e/-e around this one: it's a plain assignment (not part of an
	# `||`/`if` list), so under `set -e` a non-zero pve_try_create here
	# would abort the whole script instead of falling through to the
	# warn-and-continue handling below.
	set +e
	token_out="$(pve_try_create "token vnprox@pve!daemon" \
		pveum user token add vnprox@pve daemon --privsep 0 --output-format json)"
	token_create_rc=$?
	set -e
	if [ $token_create_rc -ne 0 ]; then
		: # pve_try_create already warned
	elif printf '%s' "$token_out" | grep -q '"value"'; then
		token_value="$(printf '%s' "$token_out" | sed -n 's/.*"value" *: *"\([^"]*\)".*/\1/p')"
		install -d -m 0700 -o root -g root "$KEYS_DIR"
		umask 077
		printf 'vnprox@pve!daemon=%s\n' "$token_value" >"$PVE_TOKEN_FILE"
		chmod 0600 "$PVE_TOKEN_FILE"
		log "  stored token secret at $PVE_TOKEN_FILE (root:root 0600)"
	else
		# The "already existed" branch: pveum won't hand back a secret for
		# a token that already existed before this run, and there is no
		# way to recover one that was never written to disk here.
		warn "  PVE API token vnprox@pve!daemon already exists but $PVE_TOKEN_FILE is missing/empty; its secret cannot be recovered — either restore $PVE_TOKEN_FILE from backup, or run: pveum user token remove vnprox@pve daemon && vnprox-setup again"
	fi
fi

# --- step 6: cluster secret ------------------------------------------------
#
# The cluster secret only needs to be *generated once*; pmxcfs replicates
# anything under /etc/pve to every node automatically, so subsequent nodes
# in a real cluster will already see this file. That "automatic replication
# across an actual cluster" is the part this sandbox cannot verify — it
# requires a live pmxcfs mount and real corosync-joined nodes, so it is
# still tracked as TODO(T-606) for verification, even though local
# generation below is real, not faked.
if [ -d /etc/pve ]; then
	install -d -m 0700 -o root -g root "$PVE_CLUSTER_DIR" 2>/dev/null || warn "could not create $PVE_CLUSTER_DIR (is /etc/pve writable / is pmxcfs running?)"
	if [ -s "$CLUSTER_SECRET_FILE" ]; then
		log "cluster secret already present at $CLUSTER_SECRET_FILE, leaving it untouched"
	else
		umask 077
		# Hex-encoded, not raw bytes: internal/peer/secret.go's SecretStore
		# hex-decodes this file's content (it also generates hex-encoded
		# content itself, for the case where the daemon wins the "who
		# generates first" race instead of vnprox-setup). Hardware validation
		# (T-608) found this file previously written as raw binary here,
		# which made every real vnproxd crash-loop at startup with "cluster
		# secret ... is not valid hex" — a bug no sandboxed test caught
		# because none of them start a real vnprox.service under systemd
		# against a vnprox-setup-generated secret.
		if command -v openssl >/dev/null 2>&1; then
			openssl rand -hex 32 >"$CLUSTER_SECRET_FILE" && chmod 0600 "$CLUSTER_SECRET_FILE"
		else
			head -c 32 /dev/urandom | od -An -vtx1 | tr -d ' \n' >"$CLUSTER_SECRET_FILE" && printf '\n' >>"$CLUSTER_SECRET_FILE" && chmod 0600 "$CLUSTER_SECRET_FILE"
		fi
		if [ -s "$CLUSTER_SECRET_FILE" ]; then
			log "generated new cluster secret at $CLUSTER_SECRET_FILE"
		else
			warn "failed to generate $CLUSTER_SECRET_FILE"
		fi
	fi
	log "TODO(T-606): verify pmxcfs replication of $CLUSTER_SECRET_FILE across all cluster nodes on real hardware"
else
	log "TODO(T-606): /etc/pve not present (no pmxcfs) — cluster secret bootstrap skipped; this step requires a real Proxmox VE node/cluster"
fi

# --- step 7: config, session key, enable+start ----------------------------

log "writing $CONFIG_PATH (listen port $RESOLVED_PORT)"
if [ -f "$CONFIG_PATH" ]; then
	if command -v sed >/dev/null 2>&1; then
		sed -i.bak -E "s/^listen = \".*\"/listen = \"0.0.0.0:${RESOLVED_PORT}\"/" "$CONFIG_PATH"
		rm -f "${CONFIG_PATH}.bak"
	fi
else
	warn "$CONFIG_PATH not found (expected the package's conffile to be here) — writing a minimal one"
	install -d -m 0755 -o root -g root "$(dirname "$CONFIG_PATH")"
	cat >"$CONFIG_PATH" <<EOF
[server]
listen = "0.0.0.0:${RESOLVED_PORT}"
read_only = false
confirm_timeout_default = 120

[pve]
api_url = "https://127.0.0.1:8006"
token_file = "/etc/vnprox/keys/pve-token"

[safety]
allow_dangerous_ops = false

[collect]
pve_interval = "10s"
host_interval = "5s"
lldp_interval = "30s"
EOF
	chmod 0644 "$CONFIG_PATH"
fi

# Idempotent session key generation, mirroring postinst exactly — belt and
# braces in case vnprox-setup is ever invoked without the package's
# postinst having run (e.g. a future re-setup command).
install -d -m 0700 -o root -g root "$KEYS_DIR"
if [ -s "$SESSION_KEY_FILE" ]; then
	log "session key already present at $SESSION_KEY_FILE"
else
	umask 077
	if command -v openssl >/dev/null 2>&1; then
		openssl rand -out "$SESSION_KEY_FILE" 32
	else
		head -c 32 /dev/urandom >"$SESSION_KEY_FILE"
	fi
	chown root:root "$SESSION_KEY_FILE"
	chmod 0600 "$SESSION_KEY_FILE"
	log "generated session key at $SESSION_KEY_FILE"
fi

if [ -d /run/systemd/system ]; then
	systemctl daemon-reload || true
	systemctl enable --now vnprox.service
	log "vnprox.service enabled and started"
else
	warn "systemd is not the running init system in this environment; run manually: systemctl enable --now vnprox"
fi

# --- checklist -------------------------------------------------------------

cat <<EOF

vnprox setup complete for this node.

  URL:              https://$(hostname -f 2>/dev/null || hostname):${RESOLVED_PORT}
  Config:           $CONFIG_PATH
  Session key:      $SESSION_KEY_FILE
  Logs:             journalctl -u vnprox

First-login checklist:
  - Log in with your existing Proxmox VE credentials (no separate vnprox account).
  - Restrict port ${RESOLVED_PORT} to management networks, same as you should for 8006
    (see docs/security.md "Firewalling vnprox itself").
  - Repeat this setup on every other cluster node (install.sh offers to do
    this over SSH; see its output for the current state of that feature).
EOF
