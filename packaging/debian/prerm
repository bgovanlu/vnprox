#!/bin/sh
# prerm for the vnprox .deb: stop the running service before its files are
# removed (both plain `apt remove` and `apt purge` invoke prerm the same
# way — the remove/keep-data-vs-purge-data distinction is entirely in
# postrm). See planning/tasks/phase-0.md#T-006.

set -e

case "$1" in
  remove|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl stop vnprox.service >/dev/null 2>&1 || true
      # T-1901: the optional scheduled-backup timer ships disabled, but an
      # operator may have enabled it. Disable it before its unit files are
      # removed, or systemd is left with a dangling enablement symlink.
      systemctl disable --now vnprox-backup.timer >/dev/null 2>&1 || true
    fi
    ;;
  upgrade|failed-upgrade)
    if [ -d /run/systemd/system ]; then
      # Record whether the service was running before we stop it, so
      # postinst can bring it back up once the new files are in place. A
      # fresh install writes no such flag, so it stays stopped (auto-starting
      # an unconfigured node would crash-loop — see postinst). /run is tmpfs,
      # so the flag is inherently scoped to this boot / this upgrade.
      if systemctl is-active --quiet vnprox.service; then
        mkdir -p /run/vnprox
        : > /run/vnprox/restart-after-upgrade
      fi
      systemctl stop vnprox.service >/dev/null 2>&1 || true
    fi
    ;;
  *)
    ;;
esac

exit 0
