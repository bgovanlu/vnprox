#!/bin/sh
# postinst for the vnprox .deb — see docs/deployment.md ("Install") and
# planning/tasks/phase-0.md#T-006.
#
# Responsibilities (deliberately narrow — see prerm/postrm for the rest of
# the lifecycle, and install.sh/vnprox-setup for the interactive parts that
# need a real PVE environment):
#   1. Create /var/lib/vnprox (the daemon's DB/snapshots directory).
#   2. Idempotently generate the session encryption key
#      (/etc/vnprox/keys/session.key, root:root 0600, per docs/security.md
#      "Authentication" and AES-256-GCM key-file convention) — generated
#      once at install, never overwritten on upgrade.
#   3. Reload systemd's unit cache so `vnprox.service` is recognized.
#   4. (T-1004) Sync a systemd drop-in granting CAP_BPF/CAP_PERFMON to
#      vnprox.service's CapabilityBoundingSet, but ONLY when
#      /etc/vnprox/vnprox.toml has `[flows] ebpf_sampling_enabled = true` —
#      see sync_ebpf_caps_dropin below and docs/security.md's Host
#      footprint section. Never granted unconditionally.
#
# This script deliberately does NOT enable or start vnprox.service on a
# fresh install: the shipped default config assumes a real Proxmox VE node
# (PVE certificate reuse, PVE API on :8006) and has no PVE token yet, so an
# unconditional auto-start would crash-loop. Enabling/starting is the
# explicit, documented final step of `vnprox-setup` / the manual install
# flow ("systemctl enable --now vnprox" in docs/deployment.md), and of
# install.sh's per-node rollout.
#
# On an *upgrade*, though, a node that was already running vnprox must not be
# silently left stopped by `apt install ./vnprox_*.deb` (or `apt install
# vnprox`). This script restarts the service on upgrade when it was running —
# detected via prerm's flag (precise) or, since prerm runs from the *old*
# package and older versions' prerm never wrote that flag, via the unit being
# enabled (the reliable fallback). Fresh installs stay stopped.

set -e

VAR_LIB_DIR=/var/lib/vnprox
KEYS_DIR=/etc/vnprox/keys
WIREGUARD_DIR=/etc/wireguard
SESSION_KEY_FILE="$KEYS_DIR/session.key"
CONFIG_FILE=/etc/vnprox/vnprox.toml
EBPF_DROPIN_DIR=/etc/systemd/system/vnprox.service.d
EBPF_DROPIN_FILE="$EBPF_DROPIN_DIR/10-ebpf-caps.conf"

# sync_ebpf_caps_dropin implements docs/security.md's Host footprint
# section / T-1004's card: the shipped vnprox.service unit's
# CapabilityBoundingSet never includes CAP_BPF/CAP_PERFMON (needed only by
# internal/flow/hostsample's eBPF sampler) — this function is the ONLY
# place that ever grants them, and only when this node's own
# vnprox.toml explicitly opts in. Idempotent and safe to call on every
# configure (fresh install or upgrade): it (re)writes the drop-in when
# enabled, or removes it (and prunes the now-empty drop-in directory) when
# disabled/absent, so toggling the config key off in vnprox.toml and
# reinstalling/upgrading revokes the capability again — this is
# deliberately not automatic on a plain `systemctl restart` (only on
# package configure), matching every other "restart-time file" config
# value in this project (docs/api.md's GET /config note).
#
# Matching is a plain grep for the exact `ebpf_sampling_enabled = true`
# key/value pair, the same simplicity level packaging/bin/vnprox-setup's
# own sed-based vnprox.toml edits already use — vnprox.toml has one
# section per feature and no nested tables, so a bare key match is
# unambiguous in practice; this does not attempt a real TOML parse.
sync_ebpf_caps_dropin() {
  ebpf_enabled=false
  if [ -f "$CONFIG_FILE" ] && grep -Eq '^[[:space:]]*ebpf_sampling_enabled[[:space:]]*=[[:space:]]*true([[:space:]]|#|$)' "$CONFIG_FILE"; then
    ebpf_enabled=true
  fi

  if [ "$ebpf_enabled" = true ]; then
    echo "vnprox: [flows] ebpf_sampling_enabled = true — granting CAP_BPF/CAP_PERFMON to vnprox.service via $EBPF_DROPIN_FILE"
    install -d -m 0755 -o root -g root "$EBPF_DROPIN_DIR"
    cat > "$EBPF_DROPIN_FILE" <<'EOF'
# Written by vnprox's postinst ONLY while /etc/vnprox/vnprox.toml has
# [flows] ebpf_sampling_enabled = true (docs/security.md's Host footprint
# section, T-1004). Removed automatically the next time the package is
# configured with that key absent/false. Do not edit by hand — edit
# vnprox.toml's [flows] section instead and reinstall/upgrade the package
# (or run `dpkg-reconfigure vnprox` where supported) to regenerate this
# file.
[Service]
CapabilityBoundingSet=CAP_BPF CAP_PERFMON
EOF
    chmod 0644 "$EBPF_DROPIN_FILE"
  elif [ -e "$EBPF_DROPIN_FILE" ]; then
    echo "vnprox: [flows] ebpf_sampling_enabled is not true — revoking the CAP_BPF/CAP_PERFMON grant ($EBPF_DROPIN_FILE)"
    rm -f "$EBPF_DROPIN_FILE"
    rmdir "$EBPF_DROPIN_DIR" 2>/dev/null || true
  fi
}

case "$1" in
  configure)
    install -d -m 0700 -o root -g root "$VAR_LIB_DIR"
    install -d -m 0700 -o root -g root "$KEYS_DIR"
    # (v3.0.2) Ensure /etc/wireguard exists so the unit's
    # ReadWritePaths=... /etc/wireguard ... entry always has a bind target:
    # ProtectSystem=strict makes it read-only otherwise, and a WireGuard
    # changeset apply (cmd/vnproxd/wireguard.go) writes wg-quick configs
    # there. 0700 root:root is wireguard-tools' own convention; idempotent
    # and harmless on nodes that never use WireGuard. If wireguard-tools is
    # later installed it reuses this same dir/mode.
    install -d -m 0700 -o root -g root "$WIREGUARD_DIR"

    if [ -s "$SESSION_KEY_FILE" ]; then
      echo "vnprox: session encryption key already present at $SESSION_KEY_FILE, leaving it untouched"
    else
      umask 077
      if command -v openssl >/dev/null 2>&1; then
        openssl rand -out "$SESSION_KEY_FILE" 32
      else
        head -c 32 /dev/urandom > "$SESSION_KEY_FILE"
      fi
      chown root:root "$SESSION_KEY_FILE"
      chmod 0600 "$SESSION_KEY_FILE"
      echo "vnprox: generated new session encryption key at $SESSION_KEY_FILE"
    fi

    sync_ebpf_caps_dropin

    # /run/systemd/system only exists when systemd is the running init
    # system (not the case in most build/test containers) — guard every
    # systemctl call on it so this script is a no-op there instead of
    # failing the package install.
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload >/dev/null 2>&1 || true
      # On an upgrade ($2 = previously-installed version), bring the service
      # back up if it was running before — either because prerm recorded the
      # flag (precise), or, failing that, because the unit is enabled. The
      # enabled fallback matters because prerm runs from the *old* package:
      # upgrading from a version whose prerm predates the flag would otherwise
      # never restart. A fresh install has no $2 (and the unit isn't enabled
      # until vnprox-setup does so), so it stays stopped — see the header.
      if [ -n "${2:-}" ]; then
        if [ -e /run/vnprox/restart-after-upgrade ] || systemctl is-enabled --quiet vnprox.service; then
          systemctl start vnprox.service >/dev/null 2>&1 || true
        fi
      fi
      rm -f /run/vnprox/restart-after-upgrade 2>/dev/null || true
    fi
    ;;
  abort-upgrade|abort-remove|abort-deconfigure)
    ;;
  *)
    ;;
esac

exit 0
