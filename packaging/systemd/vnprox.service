[Unit]
Description=vnprox - visual networking add-on for Proxmox VE
Documentation=https://github.com/bgovanlu/vnprox
# pve-cluster.service (pmxcfs) provides /etc/pve; vnprox reads the node's PVE
# certificate and (once T-301 lands) the cluster secret from under it.
# vnprox degrades gracefully if pmxcfs is briefly unavailable, so this is a
# soft ordering dependency (After=), not a hard requirement (Requires=).
After=network-online.target pve-cluster.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/vnproxd --config /etc/vnprox/vnprox.toml
Restart=on-failure
RestartSec=2s

# Graceful shutdown: vnproxd drains in-flight requests and exits within 3s
# of SIGTERM (cmd/vnproxd acceptance criterion, planning/tasks/phase-0.md
# #T-002). TimeoutStopSec leaves headroom above that budget before systemd
# escalates to SIGKILL.
TimeoutStopSec=15s

# --- Host footprint hardening -------------------------------------------
# Directives below are exactly what docs/security.md's "Host footprint"
# section documents as v1 requirements. v1 runs as root (no User=/Group=
# drop) — capability *reduction* to a non-root identity is tracked
# separately as T-604 (planning/tasks/phase-6.md); do not add a User=
# directive here until that task lands and the daemon itself supports it
# (netlink admin, ifreload, and reading root:root 0600 key/DB files
# currently all assume root).
ProtectSystem=strict
# /etc/vnprox/keys must be writable: several first-run secrets are generated
# by the daemon on first boot under this directory — the session AES key
# (cipher.go), the Prometheus metrics scrape token (T-1001,
# /etc/vnprox/keys/metrics.key) and the blueprint signing key (T-1705,
# /etc/vnprox/keys/blueprint-signing.key) — each written 0600 root:root if
# absent, then loaded verbatim on every subsequent boot. postinst only
# pre-seeds session.key, so without this path the metrics/blueprint keys hit
# `open ...: read-only file system` under ProtectSystem=strict and the daemon
# crash-loops on the first upgrade from a release predating them (found on
# real hardware upgrading 1.3.6 -> 3.0.0). The rest of /etc stays read-only
# and the key files keep their 0600 root:root perms.
#
# /etc/wireguard must also be writable: applying a WireGuard changeset op
# writes each tunnel's wg-quick config there (cmd/vnproxd/wireguard.go's
# hostWGGateway: MkdirAll 0700 + WriteFile 0600 under /etc/wireguard). Under
# ProtectSystem=strict this path was read-only, so every WireGuard apply on a
# hardened host failed with `... read-only file system` — the same crash class
# as the keys bug above, missed by the v3.0.1 fix because it only covered the
# first-boot key writes. Added in v3.0.2. (The cluster secret's fallback
# generate-if-absent write to /etc/pve/priv/vnprox/ is deliberately NOT added
# here: /etc/pve is a pmxcfs FUSE mount that vnprox-setup pre-seeds, and
# whether ProtectSystem=strict even makes it read-only is pending hardware
# validation — see planning/reports/needs-hardware-validation.md.)
ReadWritePaths=/var/lib/vnprox /etc/vnprox/keys /etc/wireguard /etc/network /run
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

# "capability bounding to what netlink/ifreload require" (docs/security.md).
# vnproxd still runs as root (UID 0), but the kernel's capability bounding
# set constrains which capabilities that root process can ever hold, even
# if compromised — CAP_NET_ADMIN/CAP_NET_RAW for netlink + bridge/bond/vlan
# management and ethtool, CAP_NET_BIND_SERVICE in case a future release
# binds a low port, CAP_DAC_OVERRIDE/CAP_DAC_READ_SEARCH for reading
# root:root 0600 key/DB files and traversing /etc/network and /etc/pve,
# CAP_CHOWN/CAP_FOWNER for writing snapshot/audit files under
# /var/lib/vnprox. Broad, unrelated capabilities (CAP_SYS_ADMIN,
# CAP_SYS_MODULE, CAP_SYS_PTRACE, CAP_SYS_BOOT, ...) are deliberately
# excluded. Revisit alongside T-604.
#
# CAP_SETPCAP (added 2026-08-18, T-3201 follow-up — real-hardware finding,
# planning/reports/blocked-validation.md §2.6): needed for `ping` itself to
# complete its OWN privilege drop, not for vnproxd to do anything with it
# directly. Modern iputils-ping (Debian's shipped build) opens its raw ICMP
# socket first (CAP_NET_RAW, already above), then calls cap_set_proc() to
# drop capabilities it no longer needs as its own defense-in-depth measure —
# and aborts hard (exit 255, "cap_set_proc: Operation not permitted") if
# that call itself fails, even though the socket it actually needs was
# already opened successfully. cap_set_proc() requires CAP_SETPCAP in the
# calling thread's permitted set; without it here, every `ping` this daemon
# execs (internal/mtuprobe's DF-probe, internal/latmesh's RTT/loss mesh,
# internal/wan's reference-target probing) always failed under this exact
# systemd hardening, confirmed on a real two-node PVE 9.2.10 cluster: a
# debug capture caught the daemon's own ping invocation exiting 255 with
# "ping: cap_set_proc: Operation not permitted" while an identical manual
# ping (run outside vnprox.service's systemd scope entirely) succeeded
# cleanly against the same target. Per capabilities(7): a process's
# capability bounding set is a ceiling on what its permitted/effective sets
# can ever contain, inherited by every child this unit execs; granting
# CAP_SETPCAP here lets `ping` (a child process, distinct from vnproxd
# itself) manipulate ITS OWN process capability sets — specifically to drop
# them further, per ping's own hardening design — not to raise them or
# affect vnproxd's. On a modern kernel with file capabilities (every kernel
# vnprox targets), CAP_SETPCAP does not by itself grant the ability to pass
# arbitrary capabilities to another process's permitted set beyond what the
# grantor's own bounding set already allows, so this does not widen what a
# compromised `ping` child could hand to some other process — it only
# unblocks `ping`'s own already-benign self-restriction. Without this
# capability, `ping` cannot run under this daemon's sandboxing AT ALL — it
# is not a partial degradation, since dfProbe/RealProber's own defensive
# "did not confirm success" fallback (see their doc comments) makes a hard
# exec failure indistinguishable from a genuine 100% packet loss/path-MTU
# failure, so this was previously producing false positives on every
# correctly-hardened install, not merely a missing optimization.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER CAP_SETPCAP

# T-1004 (docs/security.md's Host footprint section): internal/flow/
# hostsample's eBPF flow sampler additionally needs CAP_BPF and
# CAP_PERFMON, deliberately NOT listed above — those two are only ever
# granted via a systemd drop-in (/etc/systemd/system/vnprox.service.d/
# 10-ebpf-caps.conf, unioned with this unit's own CapabilityBoundingSet=
# per systemd.exec(5)) that packaging/debian/postinst writes ONLY when
# this node's /etc/vnprox/vnprox.toml has [flows] ebpf_sampling_enabled =
# true at install/upgrade time, and removes otherwise. A node that never
# opts in keeps exactly the capability set below, unchanged; do not add
# CAP_BPF/CAP_PERFMON here directly.

# --- Additional defense-in-depth (not explicitly enumerated in the ------
# --- security doc, but standard-safe for a pure-Go, no-cgo, root ------
# --- network daemon; kept here since systemd-analyze security flags -----
# --- them and none are known to conflict with vnproxd's documented ------
# --- behavior). Remove any of these first if a real-host install hits ---
# --- a regression traced back to one. ------------------------------------
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
SystemCallArchitectures=native

# T-604 hardening pass (planning/tasks/phase-6.md, docs/security.md's
# "Host footprint" section) landed these two directives — measured, not
# guessed, against every socket/syscall path this binary actually exercises
# (internal/host's use of github.com/vishvananda/netlink for rtnetlink
# link/address/route/neighbor management, the HTTPS/WS server and the
# PVE/peer HTTP clients, and the fixed-argv subprocess execs documented
# above CapabilityBoundingSet — lldpctl, ethtool, ifreload/ifup/ifdown,
# ovs-vsctl, systemctl, vtysh):
#
# RestrictAddressFamilies: vnproxd is pure Go with no cgo (go.mod has no
# cgo dependency; modernc.org/sqlite and vishvananda/netlink are both
# cgo-free), so the stdlib name resolver never needs AF_UNIX to reach
# nscd/systemd-resolved the way a cgo-linked getaddrinfo() call might —
# only AF_INET/AF_INET6 (HTTPS/WS server, PVE API client, peer API
# client/server) and AF_NETLINK (rtnetlink link/address/route/neighbor
# operations) are ever opened by vnproxd itself.
#
# AF_UNIX **is** required, though (hardware validation, T-608, found this
# the hard way): this seccomp filter is inherited across exec by every
# child process the unit spawns — including the lldpctl subprocess exec
# the CapabilityBoundingSet comment above already documents. lldpctl talks
# to lldpd over a Unix domain socket (/run/lldpd.socket); without AF_UNIX
# here, that socket() call is killed by the kernel and every LLDP poll
# fails outright. No sandboxed test caught this because none of them run a
# real systemd-confined vnprox.service actually invoking lldpctl.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX

# SystemCallFilter: @system-service is systemd's own curated allowlist for
# well-behaved services (networking, file I/O, process spawning for the
# subprocess execs above, standard signal/timer/memory syscalls) and
# already excludes the dangerous groups explicitly re-denied below for
# defense in depth (belt-and-suspenders in case a future systemd release
# ever loosens @system-service's own definition). None of vnproxd's
# documented operations (netlink admin, ifreload-family subprocess execs,
# HTTPS/WS serving, SQLite file I/O) need kernel module loading, mount/
# reboot/swap control, raw I/O, or the debug/tracing syscalls below, so
# they are removed even though root's capability bounding set (above)
# already blocks most of the capabilities that would make them useful to
# an attacker anyway.
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap @privileged @resources @raw-io @debug @module @cpu-emulation @obsolete @clock
#
# capset, setuid (added 2026-08-18, T-3201 follow-up — real-hardware finding,
# planning/reports/blocked-validation.md §2.6): re-permitted individually
# after the @privileged denial above, since `systemd-analyze syscall-filter
# @privileged` confirms both syscalls live in that group and are denied by
# it — CAP_SETPCAP alone (this unit's CapabilityBoundingSet= line, same
# finding) is NOT sufficient on its own to let `ping` complete its
# privilege-drop, because this seccomp filter (inherited across exec, same
# as the AF_UNIX/lldpctl finding above) blocks the underlying capset(2)
# syscall outright regardless of which capabilities the calling thread
# holds. Confirmed empirically on a real two-node PVE 9.2.10 cluster via
# `systemd-run` reproductions matching this unit's exact directives one at a
# time: CapabilityBoundingSet with CAP_SETPCAP alone still failed
# (`ping: cap_set_proc: Operation not permitted`); adding `capset` to the
# allowlist changed the failure to `ping: setuid: Operation not permitted`
# (iputils-ping's privilege-drop sequence calls capset() to drop
# capabilities, then setuid() as defense-in-depth to also drop any residual
# UID-level privilege — both gate the same drop, not two independent
# features); adding `setuid` alongside `capset` let `ping` complete
# cleanly. Neither addition widens what a compromised child could actually
# do: `capset` only lets a process rearrange bits WITHIN its own existing
# capability sets (never gain a capability the CapabilityBoundingSet above
# doesn't already grant — capabilities(7)), and `setuid` without CAP_SETUID
# in the bounding set (deliberately not present here) can only set a
# process's UID to a value it already holds as its real/effective/saved
# UID — for a process that stays at UID 0 throughout, as every vnproxd
# child does, that is a no-op transition (setuid(0) while already 0), never
# a path to a *different* UID. Scoped to exactly these two syscalls rather
# than re-allowing the rest of `@privileged` (which also holds mount/
# pivot_root/reboot/module-loading and other syscalls vnproxd has no
# documented need for).
SystemCallFilter=capset setuid
SystemCallErrorNumber=EPERM
# T-2905: verified (systemd-analyze syscall-filter): setns lives in
# @process, which @system-service includes, and appears in none of the
# groups denied above — so the nsenter-based guest-interior read path works
# under this exact filter. Recorded here so nobody re-tightens this into
# breaking it without noticing.

# T-2905: files this daemon creates default to owner-only. Everything
# secret already gets an explicit chmod (the store's 0600s, postinst's key
# handling); UMask is the backstop for every os.WriteFile that never
# thought about permissions.
UMask=0077
# T-2905: the daemon may JOIN existing namespaces (setns for the
# guest-interior lxc reads — net/mnt/pid) but never needs to create USER
# namespaces, the primitive most kernel-LPE chains want. ~user denies
# exactly that and nothing the documented operations use.
RestrictNamespaces=~user

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vnproxd

[Install]
WantedBy=multi-user.target
