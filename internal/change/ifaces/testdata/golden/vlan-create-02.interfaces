auto lo
iface lo inet loopback

auto eno1
iface eno1 inet manual
	mtu 9000

auto vmbr0
iface vmbr0 inet static
	address 10.0.0.5/24
	gateway 10.0.0.1
	bridge-ports eno1
	bridge-vlan-aware yes
	bridge-vids 2-4094
	bridge-stp off
	bridge-fd 0
	mtu 9000

auto vmbr0.20
iface vmbr0.20 inet static
	address 10.0.20.5/24
	vlan-raw-device vmbr0

auto vmbr0.30
iface vmbr0.30 inet static
	# managed by vnprox (changeset TESTCS01)
	address 10.0.30.5/24
	vlan-raw-device vmbr0
	mtu 1500

